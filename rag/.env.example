# Copy this file to .env and fill in real values. .env is gitignored.

# --- OpenAI (embeddings for the RAG retrieval pipeline) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Local Chroma vector store (optional — defaults shown) ---
CHROMA_PERSIST_DIR=rag/vectorstore/chroma
CHROMA_COLLECTION_NAME=nexus_knowledge_base

# --- Hybrid retriever tuning (optional — defaults shown) ---
RETRIEVER_DEFAULT_K=5
RETRIEVER_BM25_WEIGHT=0.4
RETRIEVER_VECTOR_WEIGHT=0.6
